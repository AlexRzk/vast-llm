#!/usr/bin/env bash
set -u

LIB_DIR="${VAST_LLM_LIB_DIR:-/usr/local/lib/vast-llm}"
ENV_FILE="$LIB_DIR/environment"
if [[ -r "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi
CORE="${VAST_LLM_CORE:-$LIB_DIR/vast-llm-core}"
UI="${VAST_LLM_UI:-$LIB_DIR/vast-llm-ui}"
BENCH="${VAST_LLM_BENCH:-$LIB_DIR/vast-llm-bench}"
DOCTOR="${VAST_LLM_DOCTOR:-$LIB_DIR/vast-llm-doctor}"
AUTO="${VAST_LLM_AUTO:-$LIB_DIR/vast-llm-auto}"
STATE_DIR="${VAST_LLM_STATE_DIR:-/data/vast-llm}"
CURRENT_FILE="$STATE_DIR/current_profile"
SERVER_PATH_FILE="$STATE_DIR/llama_server_path"
RUNTIME_LD_FILE="$STATE_DIR/llama_runtime_ld_path"

for f in "$CORE" "$UI" "$BENCH" "$DOCTOR" "$AUTO"; do
  [[ -x "$f" ]] || { printf 'ERROR: missing executable %s. Re-run install.sh.\n' "$f" >&2; exit 1; }
done

activate_repaired_runtime() {
  local server runtime_ld wrapper q_server q_ld
  if [[ -s "$SERVER_PATH_FILE" ]]; then
    server="$(cat "$SERVER_PATH_FILE")"
    if [[ -x "$server" ]]; then
      runtime_ld=""
      [[ -s "$RUNTIME_LD_FILE" ]] && runtime_ld="$(cat "$RUNTIME_LD_FILE")"
      wrapper="$STATE_DIR/runtime/llama-server-launch"
      mkdir -p "$(dirname "$wrapper")"
      printf -v q_server '%q' "$server"
      printf -v q_ld '%q' "$runtime_ld"
      cat > "$wrapper" <<EOF
#!/usr/bin/env bash
export LD_LIBRARY_PATH=$q_ld
export LD_PRELOAD=
exec $q_server "\$@"
EOF
      chmod 700 "$wrapper"
      export LLAMA_SERVER="$wrapper"
      export VAST_LLM_REPAIRED_RUNTIME=1
    fi
  fi
}

activate_repaired_runtime

c_reset='\033[0m'; c_bold='\033[1m'; c_yellow='\033[33m'
if [[ -n "${NO_COLOR:-}" ]]; then c_reset=''; c_bold=''; c_yellow=''; fi
warn() { printf '%b%s%b\n' "$c_yellow" "$*" "$c_reset" >&2; }

current_profile() {
  if [[ -s "$CURRENT_FILE" ]]; then cat "$CURRENT_FILE"; else printf 'default'; fi
}

sleep_tiny() { sleep "$1" 2>/dev/null || true; }

splash_enabled() {
  [[ "${VAST_LLM_NO_SPLASH:-0}" != 1 ]] || return 1
  [[ -t 1 ]] || return 1
  [[ "${TERM:-dumb}" != dumb ]] || return 1
}

show_splash() {
  local reset='\033[0m' bold='\033[1m' cyan='\033[38;5;51m' blue='\033[38;5;39m' violet='\033[38;5;141m' dim='\033[2m' green='\033[38;5;82m'
  [[ -z "${NO_COLOR:-}" ]] || { reset=''; bold=''; cyan=''; blue=''; violet=''; dim=''; green=''; }
  printf '\033[?25l'; trap 'printf "\033[?25h"' EXIT INT TERM
  clear 2>/dev/null || printf '\n'
  local -a art=(
'██╗   ██╗ █████╗ ███████╗████████╗      ██╗     ██╗     ███╗   ███╗'
'██║   ██║██╔══██╗██╔════╝╚══██╔══╝      ██║     ██║     ████╗ ████║'
'██║   ██║███████║███████╗   ██║         ██║     ██║     ██╔████╔██║'
'╚██╗ ██╔╝██╔══██║╚════██║   ██║         ██║     ██║     ██║╚██╔╝██║'
' ╚████╔╝ ██║  ██║███████║   ██║         ███████╗███████╗██║ ╚═╝ ██║'
'  ╚═══╝  ╚═╝  ╚═╝╚══════╝   ╚═╝         ╚══════╝╚══════╝╚═╝     ╚═╝'
  )
  local i color
  for ((i=0;i<${#art[@]};i++)); do
    case $((i%3)) in 0) color="$cyan";; 1) color="$blue";; *) color="$violet";; esac
    printf '%b%b%s%b\n' "$bold" "$color" "${art[$i]}" "$reset"
    sleep_tiny "${VAST_LLM_SPLASH_SPEED:-0.02}"
  done
  printf '\n%b      Vast.ai native CUDA inference control plane%b\n' "$dim" "$reset"
  printf '%b      auto-detect • profiles • tuning • benchmarks%b\n\n' "$dim" "$reset"
  local -a frames=('◐' '◓' '◑' '◒') stages=('NVIDIA CUDA' 'Hardware advisor' 'Profiles' 'Ready')
  for ((i=0;i<4;i++)); do printf '\r%b%s%b  %-18s' "$cyan" "${frames[$i]}" "$reset" "${stages[$i]}"; sleep_tiny "${VAST_LLM_SPLASH_STAGE_SPEED:-0.07}"; done
  printf '\r%b✓%b  %-18s\n\n' "$green" "$reset" 'Control plane online'
  printf '\033[?25h'; trap - EXIT INT TERM
}

main_menu() {
  local cur choice np
  while true; do
    cur="$(current_profile)"
    echo
    printf '%bVast.ai LLM Manager%b — current: %s\n' "$c_bold" "$c_reset" "$cur"
    cat <<'EOF'
  1) Hardware detect + recommended models
  2) Auto-setup recommended model
  3) Quick settings / performance tuning
  4) Status
  5) Start
  6) Stop
  7) Restart
  8) Benchmark Center
  9) Profiles / switch profile
 10) Full configuration wizard
 11) Doctor / native CUDA repair
 12) Show API key
 13) Advanced manager menu
  0) Exit
EOF
    read -r -p 'Choose: ' choice || return
    case "$choice" in
      1) "$AUTO" recommend ;;
      2) "$AUTO" setup ;;
      3) "$UI" settings "$cur" ;;
      4) "$CORE" status "$cur" ;;
      5) "$CORE" start "$cur" ;;
      6) "$CORE" stop "$cur" ;;
      7) "$CORE" restart "$cur" ;;
      8) "$BENCH" menu ;;
      9)
        "$CORE" profiles
        read -r -p 'Profile to use (blank = keep current): ' np || true
        [[ -z "$np" ]] || "$CORE" use "$np"
        ;;
      10) "$CORE" wizard "$cur" ;;
      11) "$DOCTOR" ;;
      12) "$CORE" key ;;
      13) "$CORE" menu ;;
      0) return ;;
      *) warn 'Unknown choice.' ;;
    esac
  done
}

usage() {
  cat <<'EOF'
Vast LLM Manager additions

Bare-metal / native CUDA:
  vast-llm hardware                Detect GPU/VRAM/CUDA/RAM/disk
  vast-llm recommend               Recommend models that fit this server
  vast-llm auto-setup              Create/download/start a recommended profile
  vast-llm bootstrap               Build/fix native CUDA llama.cpp + auto-setup

Tuning:
  vast-llm settings [profile]
  vast-llm set <setting> <value> [profile]

CUDA doctor / repair:
  vast-llm doctor
  vast-llm doctor --check
  vast-llm doctor --fix
  vast-llm doctor --reset

Benchmark Center:
  vast-llm benchmarks
  vast-llm bench-suite [profile] [quick|full]
  vast-llm bench-compare <profileA> <profileB> [quick|full]
  vast-llm bench-speed [profile] [replica] [runs]
  vast-llm bench-quality [profile] [replica]
  vast-llm bench-needle [profile] [words] [replica]
  vast-llm bench-history
  vast-llm bench-custom [profile] [replica]

All ordinary commands (start, stop, restart, status, wizard, profiles, key, etc.)
are forwarded to the core manager. Docker is not required.
EOF
}

case "${1:-}" in
  ""|menu)
    splash_enabled && show_splash
    main_menu
    ;;
  hardware|detect)
    exec "$AUTO" hardware
    ;;
  recommend|models)
    exec "$AUTO" recommend
    ;;
  auto-setup|setup)
    exec "$AUTO" setup
    ;;
  bootstrap|init)
    exec "$AUTO" bootstrap
    ;;
  settings|tune|quick|set|quick-help)
    exec "$UI" "$@"
    ;;
  doctor)
    shift
    exec "$DOCTOR" "$@"
    ;;
  benchmarks|benchmark-center)
    exec "$BENCH" menu
    ;;
  bench-suite)
    shift; exec "$BENCH" suite "$@"
    ;;
  bench-compare)
    shift; exec "$BENCH" compare "$@"
    ;;
  bench-speed)
    shift; exec "$BENCH" speed "$@"
    ;;
  bench-quality)
    shift; exec "$BENCH" quality "$@"
    ;;
  bench-needle)
    shift; exec "$BENCH" needle "$@"
    ;;
  bench-history)
    exec "$BENCH" history
    ;;
  bench-custom)
    shift; exec "$BENCH" custom "$@"
    ;;
  help|-h|--help)
    usage
    echo
    "$CORE" help
    ;;
  *)
    exec "$CORE" "$@"
    ;;
esac
